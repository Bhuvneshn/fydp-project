{
  "name": "fydp-project",
  "version": "1.0.0",
  "main": "server/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/server.js",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "postinstall": "npm --prefix client install",
    "dev:server": "node --env-file-if-exists=.env --watch server/server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-session": "^1.19.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
