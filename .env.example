PORT=3000
NODE_ENV=development
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set to true once sendVerificationEmail() in server/email.js sends real email.
REQUIRE_EMAIL_VERIFICATION=false
DATA_DIR=data

# Instagram activity check (npm run check:instagram) — see server/clubs/instagram.js
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_REQUEST_DELAY_MS=18000
